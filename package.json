{
  "name": "pietron",
  "version": "2.0.0",
  "description": "Cross-platform IDE for Piet.",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnek/pietron.git"
  },
  "scripts": {
    "start": "electron src/main.js",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:win": "electron-builder --win --x64 --arm64",
    "build:linux": "electron-builder --linux --x64 --arm64",
    "build:all": "electron-builder -mwl --x64 --arm64"
  },
  "build": {
    "appId": "net.dnek.pietron",
    "productName": "Pietron",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "package.json",
      "src/**/*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "icon": "src/images/Pietron.icns"
    },
    "afterSign": "scripts/notarize.js",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/images/Pietron.ico"
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/images/Pietron.png"
    }
  },
  "keywords": [
    "pietron",
    "electron",
    "piet",
    "esolang",
    "editor",
    "debugger",
    "interpreter",
    "ide"
  ],
  "author": {
    "email": "dnek.app@gmail.com",
    "name": "dnek",
    "url": "https://dnek.net/"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^39.8.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "npm": "^11.6.4"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "jimp": "^1.6.0",
    "long": "^5.3.2",
    "split.js": "^1.6.5"
  }
}
